# Copia este archivo como ".env" y ajusta los valores (nunca subas .env a Git)
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=Tienda_Electrofernandez
# Solo si usas usuario/clave de SQL Server (si lo dejas vacío usa autenticación de Windows)
DB_USER=
DB_PASSWORD=
PORT=8050
DEBUG=0
# Opcional: forzar el último mes completo, ej. 2026-08
ULTIMO_MES=
